# This folder also holds ~33 GB of SAR data, patches, models and the venv.
# Whitelist approach: ignore everything at the root, then allow only the repository content.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/scripts/
!/results/
!/docs/
!/archive/

__pycache__/
*.pyc
*.pth
.ipynb_checkpoints/
Thumbs.db
.DS_Store
